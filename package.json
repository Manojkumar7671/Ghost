{
  "name": "ghost-core",
  "version": "1.0.0",
  "description": "Ghost AI Autonomous Matrix",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "desktop": "npx electron ./desktop-app/main.cjs",
    "desktop:build": "npx electron-builder --config.directories.output=dist",
    "package:mac": "node scratch/build_mac.js"
  },
  "build": {
    "appId": "com.manojkumar.ghost",
    "productName": "Ghost",
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "files": [
      "desktop-app/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "^26.15.3"
  }
}