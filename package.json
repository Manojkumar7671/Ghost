{
  "name": "ghost-core",
  "version": "1.0.0",
  "description": "Ghost AI Autonomous Matrix",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "desktop": "npx electron ./desktop-app/main.cjs",
    "desktop:build": "npx electron-builder --config.directories.output=dist",
    "package:mac": "node scratch/build_mac.js"
  },
  "build": {
    "appId": "com.manojkumar.ghost",
    "productName": "Ghost",
    "asar": false,
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.productivity",
      "target": "dmg"
    },
    "files": [
      "desktop-app/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.8",
    "chokidar": "^5.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "form-data": "^4.0.0",
    "fs-extra": "^11.3.6",
    "groq-sdk": "^1.3.0",
    "http-proxy-middleware": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "kokoro-js": "^1.2.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "playwright-core": "^1.61.1",
    "undici": "^6.19.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "^26.15.3"
  }
}