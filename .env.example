# ============================================================
# GHOST AI PLATFORM ENVIRONMENT CONFIGURATION
# ============================================================

# --- Core Server Settings ---
PORT=3000
GHOST_DEPLOYMENT_MODE=local
DEPLOYMENT_MODE=public
AUTH_REQUIRED=true
ADMIN_PASSPHRASE=your_admin_passphrase_here
JWT_SECRET=your_jwt_secret_here

# --- LLM Provider API Keys ---
NVIDIA_API_KEY=your_nvidia_nim_api_key
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
MINIMAX_API_KEY=your_minimax_api_key

# --- Vector & RAG Acceleration ---
# Managed automatically by Turbovec (@memwarden/turbovec)
TURBOVEC_INDEX_PATH=./memory/vector_store.tvim

# --- Synthflow MCP Voice Server ---
# PM2 Self-Hosted Synthflow MCP endpoint
MCP_SERVER_URL=http://localhost:3099/sse
SYNTHFLOW_API_KEY=your_synthflow_api_key_here

# --- Web Search & Scraping Services ---
SERPER_API_KEY=your_serper_api_key
SERPAPI_KEY=your_serpapi_key
TAVILY_API_KEY=your_tavily_api_key
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id

# --- Telephony & Voice Synthesis (Twilio / ElevenLabs / Fish Audio) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
ELEVENLABS_API_KEY=your_elevenlabs_secret_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
FISH_API_KEY=your_fish_audio_api_key

# --- Database & Persistent Storage ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres:password@db.supabase.co:6543/postgres

# --- GitHub & External Tool Integrations ---
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=Manojkumar7671
NOTION_TOKEN=your_notion_token
RENDER_API_KEY=your_render_api_key
