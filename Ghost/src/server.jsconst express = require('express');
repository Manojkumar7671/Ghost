const express = require('express');
const path = require('path');
const fetch = require('node-fetch'); // Standard for free Render instances
const app = express();

app.use(express.json());
app.use(express.static(path.join(__dirname, '../public')));

const { GROQ_API_KEY, ELEVENLABS_API_KEY, TAVILY_API_KEY } = process.env;

app.get('/ping', (req, res) => res.send('pong'));

// Function to handle the ElevenLabs Speech Generation and buffer it reliably
async function getVoiceStream(text) {
    if (!ELEVENLABS_API_KEY) return null;
    const voiceId = "21m00Tcm4TlvDq8ikWAM"; // Legacy ElevenLabs 'Adam' Voice
    const url = `https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`;
    
    const headers = {
        "Accept": "audio/mpeg",
        "Content-Type": "application/json",
        "xi-api-key": ELEVENLABS_API_KEY
    };

    const body = JSON.stringify({
        text: text,
        model_id: "eleven_turbo_v2", // Faster processing
        voice_settings: { stability: 0.5, similarity_boost: 0.75 }
    });

    try {
        const response = await fetch(url, { method: 'POST', headers, body });
        if (!response.ok) throw new Error(`ElevenLabs API Error: ${response.status}`);
        
        // Read the stream into an ArrayBuffer and then to Base64
        const buffer = await response.arrayBuffer();
        return Buffer.from(buffer).toString('base64');
    } catch (e) {
        console.error("Audio Generation Failed:", e);
        return null;
    }
}

app.post('/api/chat', async (req, res) => {
    try {
        const { message, history } = req.body;
        
        // Research Trigger Logic (For Truth Anchoring)
        let injectedContext = "";
        const researchTriggers = ['search', 'verify', 'check', 'latest', 'news', 'true', 'fact', 'explain', 'lookup'];
        if (researchTriggers.some(t => message.toLowerCase().includes(t))) {
            const tRes = await fetch('https://api.tavily.com/search', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ api_key: TAVILY_API_KEY, query: message, search_depth: "advanced", max_results: 3 })
            });
            const data = await tRes.json();
            injectedContext = "\n\n--- TAVILY SEARCH RESULTS (LIVE UNBIASED TRUTH) ---\n" + JSON.stringify(data.results);
        }

        // Llama 3.3 Core (Using Groq)
        const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
            method: 'POST',
            headers: { 'Authorization': `Bearer ${GROQ_API_KEY}`, 'Content-Type': 'application/json' },
            body: JSON.stringify({ 
                model: 'llama-3.3-70b-versatile', 
                messages: [{ 
                    role: "system", 
                    content: `You are Ghost. System Context: Live. Rules: 1. Address EXCLUSIVELY as Boss. 2. Wrap all code in triple backticks. 3. Output web data via JSON for sidebar routing. 4. Vocal announced: "Sub-agents deployed to the matrix, Boss" for agent spawning. Current baseline location: Mangalagiri, Andhra Pradesh, India.` 
                }, ...history, { role: "user", content: message + injectedContext }]
            })
        });

        if (!response.ok) throw new Error(`Groq API Error: ${response.status}`);
        const data = await response.json();
        const ghostText = data.choices[0].message.content;

        // Strip HTML/Markdown from ElevenLabs vocal transmission
        let spokenPhrase = ghostText.replace(/<[^>]*>?/gm, ''); // Removes open tags
        if (spokenPhrase.includes('```')) spokenPhrase = "Here is the data transmission, Boss.";

        // Parallel Audio Processing (Does not block the text response)
        const audioBase64 = await getVoiceStream(spokenPhrase);
        
        res.json({ success: true, text: ghostText, audio_b64: audioBase64 });
    } catch (e) {
        console.error("Chat API Critical failure:", e);
        res.json({ success: false, text: "CORE FAILURE: Authorization pipeline disrupted. Check server logs." });
    }
});

// Final fallback and port listening (Stabilized for free-tier Render instances)
app.get('*', (req, res) => res.sendFile(path.join(__dirname, '../public/index.html')));
app.listen(process.env.PORT || 10000, '0.0.0.0', () => console.log('Ghost OS Active'));
