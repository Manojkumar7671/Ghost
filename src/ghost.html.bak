<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ghost</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap');
:root{--bg:#080809;--bg2:#0f0f12;--bg3:#17171d;--bg4:#1e1e26;--border:rgba(255,255,255,0.06);--border2:rgba(255,255,255,0.1);--text:#e8e8f0;--dim:#4a4a5e;--dim2:#6b6b80;--accent:#00d4ff;--green:#00e5a0;--red:#ff4466;--mono:'IBM Plex Mono',monospace;--sans:'IBM Plex Sans',sans-serif;--sidebar:220px;--topbar:48px;}
*{margin:0;padding:0;box-sizing:border-box;}
body{background:var(--bg);color:var(--text);font-family:var(--sans);height:100vh;display:flex;flex-direction:column;overflow:hidden;}
.topbar{height:var(--topbar);background:var(--bg);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 16px;gap:12px;flex-shrink:0;}
.logo{font-family:var(--mono);font-size:15px;font-weight:600;letter-spacing:3px;color:var(--accent);display:flex;align-items:center;gap:8px;}
.logo-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);box-shadow:0 0 8px var(--accent);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.8);}}
.topbar-spacer{flex:1;}
.status-badge{font-family:var(--mono);font-size:10px;color:var(--green);display:flex;align-items:center;gap:6px;letter-spacing:1px;}
.status-dot{width:5px;height:5px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);animation:pulse 2s infinite;}
.model-pill{font-family:var(--mono);font-size:10px;padding:4px 10px;border:1px solid var(--border2);border-radius:4px;color:var(--dim2);}
.layout{display:flex;flex:1;overflow:hidden;}
.sidebar{width:var(--sidebar);background:var(--bg2);border-right:1px solid var(--border);display:flex;flex-direction:column;overflow-y:auto;flex-shrink:0;}
.sidebar::-webkit-scrollbar{width:3px;}
.sidebar::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
.sb-section{border-bottom:1px solid var(--border);}
.sb-header{display:flex;align-items:center;gap:8px;padding:10px 14px;font-family:var(--mono);font-size:9px;letter-spacing:2px;color:var(--dim);text-transform:uppercase;cursor:pointer;user-select:none;transition:color 0.15s;}
.sb-header:hover{color:var(--dim2);}
.sb-chevron{margin-left:auto;transition:transform 0.2s;font-size:8px;}
.sb-chevron.open{transform:rotate(90deg);}
.sb-items{display:none;padding:0 8px 8px;}
.sb-items.open{display:block;}
.skill-row{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;font-size:11px;color:var(--dim2);cursor:pointer;transition:background 0.15s;}
.skill-row:hover{background:var(--bg3);color:var(--text);}
.skill-dot{width:5px;height:5px;border-radius:50%;background:var(--green);box-shadow:0 0 5px var(--green);flex-shrink:0;}
.skill-name{font-family:var(--mono);font-size:10px;flex:1;}
.mem-row{padding:6px 8px;border-radius:6px;font-size:11px;color:var(--dim2);cursor:pointer;transition:background 0.15s;line-height:1.5;}
.mem-row:hover{background:var(--bg3);color:var(--text);}
.mem-key{font-family:var(--mono);font-size:9px;color:var(--accent);margin-bottom:2px;letter-spacing:1px;}
.hist-row{display:flex;align-items:center;gap:8px;padding:6px 8px;border-radius:6px;font-size:11px;color:var(--dim2);cursor:pointer;transition:background 0.15s;}
.hist-row:hover{background:var(--bg3);color:var(--text);}
.hist-label{flex:1;font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.sona-row{display:flex;justify-content:space-between;align-items:center;padding:5px 8px;font-family:var(--mono);font-size:9px;color:var(--dim);}
.sona-val{color:var(--accent);}
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;}
.activity-bar{height:36px;background:var(--bg2);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 16px;gap:8px;flex-shrink:0;overflow-x:auto;}
.activity-bar::-webkit-scrollbar{height:0;}
.activity-tag{font-family:var(--mono);font-size:9px;padding:3px 8px;border-radius:3px;border:1px solid var(--border);color:var(--dim2);letter-spacing:1px;white-space:nowrap;}
.activity-spacer{flex:1;}
.activity-clear{font-family:var(--mono);font-size:9px;color:var(--dim);cursor:pointer;padding:3px 6px;transition:color 0.15s;}
.activity-clear:hover{color:var(--red);}
.chat-area{flex:1;overflow-y:auto;padding:24px 0;scroll-behavior:smooth;}
.chat-area::-webkit-scrollbar{width:4px;}
.chat-area::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px;}
.chat-inner{max-width:740px;margin:0 auto;padding:0 24px;display:flex;flex-direction:column;gap:24px;}
.welcome{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px 0;gap:16px;text-align:center;}
.welcome-ghost{font-family:var(--mono);font-size:48px;font-weight:600;color:var(--accent);letter-spacing:-2px;text-shadow:0 0 40px rgba(0,212,255,0.3);}
.welcome-sub{font-size:13px;color:var(--dim2);max-width:400px;line-height:1.6;font-family:var(--mono);}
.welcome-hints{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:16px;width:100%;max-width:500px;}
.hint-card{background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:12px 14px;text-align:left;cursor:pointer;transition:all 0.15s;}
.hint-card:hover{border-color:var(--accent);background:var(--bg3);}
.hint-card-label{font-size:10px;color:var(--dim);margin-bottom:4px;font-family:var(--mono);letter-spacing:1px;}
.hint-card-text{font-size:12px;color:var(--text);line-height:1.4;}
.msg{display:flex;gap:12px;animation:fadeUp 0.2s ease;}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}
.msg.user{flex-direction:row-reverse;}
.msg-avatar{width:28px;height:28px;border-radius:4px;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:10px;font-weight:600;flex-shrink:0;margin-top:2px;}
.msg-avatar.ghost-av{background:rgba(0,212,255,0.12);color:var(--accent);border:1px solid rgba(0,212,255,0.2);}
.msg-avatar.user-av{background:var(--bg3);color:var(--dim2);border:1px solid var(--border);}
.msg-body{flex:1;max-width:560px;}
.msg.user .msg-body{display:flex;flex-direction:column;align-items:flex-end;}
.msg-meta{font-family:var(--mono);font-size:9px;color:var(--dim);margin-bottom:6px;letter-spacing:1px;}
.msg.user .msg-meta{text-align:right;}
.msg-bubble{padding:12px 16px;border-radius:8px;font-size:13px;line-height:1.7;white-space:pre-wrap;word-break:break-word;}
.msg.ghost .msg-bubble{background:var(--bg2);border:1px solid var(--border);color:var(--text);border-radius:2px 8px 8px 8px;}
.msg.user .msg-bubble{background:rgba(0,212,255,0.08);border:1px solid rgba(0,212,255,0.15);color:var(--text);border-radius:8px 2px 8px 8px;}
.msg-bubble code{font-family:var(--mono);font-size:12px;background:var(--bg3);padding:1px 5px;border-radius:3px;color:var(--accent);}
.msg-bubble pre{background:var(--bg3);border:1px solid var(--border);border-radius:6px;padding:12px;margin:10px 0;overflow-x:auto;font-family:var(--mono);font-size:11px;line-height:1.6;color:var(--text);}
.thinking{display:flex;gap:12px;align-items:flex-start;}
.thinking-dots{display:flex;gap:4px;padding:14px 16px;background:var(--bg2);border:1px solid var(--border);border-radius:2px 8px 8px 8px;}
.thinking-dots span{width:5px;height:5px;border-radius:50%;background:var(--dim);animation:blink 1.2s infinite;}
.thinking-dots span:nth-child(2){animation-delay:0.2s;}
.thinking-dots span:nth-child(3){animation-delay:0.4s;}
@keyframes blink{0%,80%,100%{opacity:0.2;transform:scale(0.8);}40%{opacity:1;transform:scale(1);}}
.input-area{flex-shrink:0;border-top:1px solid var(--border);background:var(--bg);padding:12px 16px 14px;}
.input-inner{max-width:740px;margin:0 auto;}
.input-box{display:flex;align-items:flex-end;gap:10px;background:var(--bg2);border:1px solid var(--border);border-radius:8px;padding:10px 12px;transition:border-color 0.15s;}
.input-box:focus-within{border-color:var(--border2);}
textarea{flex:1;background:none;border:none;outline:none;color:var(--text);font-family:var(--sans);font-size:13px;line-height:1.5;resize:none;min-height:20px;max-height:160px;overflow-y:auto;}
textarea::placeholder{color:var(--dim);}
.send-btn{background:var(--accent);border:none;border-radius:6px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all 0.15s;color:var(--bg);}
.send-btn:hover{background:#00eeff;transform:scale(1.05);}
.send-btn:disabled{background:var(--bg4);color:var(--dim);transform:none;cursor:not-allowed;}
.send-btn svg{width:14px;height:14px;}
.input-footer{display:flex;justify-content:space-between;align-items:center;margin-top:8px;padding:0 2px;}
.input-hint{font-family:var(--mono);font-size:9px;color:var(--dim);letter-spacing:1px;}
.input-actions{display:flex;gap:8px;}
.input-action-btn{font-family:var(--mono);font-size:9px;color:var(--dim);cursor:pointer;padding:2px 6px;border-radius:3px;transition:all 0.15s;border:none;background:none;}
.input-action-btn:hover{color:var(--text);background:var(--bg3);}
*{scrollbar-width:thin;scrollbar-color:var(--border2) transparent;}


</style>
</head>
<body>
<div class="topbar">
  <div class="logo"><div class="logo-dot"></div>GHOST</div>
  <div class="model-pill" id="modelPill">v9</div>
  <div class="topbar-spacer"></div>
  <div class="status-badge"><div class="status-dot"></div><span id="statusText">ONLINE</span></div>
</div>
<div class="layout">
  <div class="sidebar">
    <div class="sb-section">
      <div class="sb-header" onclick="toggleSection('skills')"><span>⬡</span> Skills<span class="sb-chevron open" id="chev-skills">›</span></div>
      <div class="sb-items open" id="sec-skills"><div style="font-family:var(--mono);font-size:9px;color:var(--dim);padding:4px 8px;letter-spacing:1px;">LOADING...</div></div>
    </div>
    <div class="sb-section">
      <div class="sb-header" onclick="toggleSection('memory')"><span>◈</span> Memory<span class="sb-chevron open" id="chev-memory">›</span></div>
      <div class="sb-items open" id="sec-memory">
        <div class="sona-row">Vectors <span class="sona-val" id="sonaVectors">—</span></div>
        <div class="sona-row">Facts <span class="sona-val" id="sonaFacts">—</span></div>
        <div class="sona-row">Learns <span class="sona-val" id="sonaLearns">—</span></div>
        <div style="padding:4px 8px 2px;">
          <div class="mem-row" onclick="sendQuick('show my profile')"><div class="mem-key">PROFILE</div>Manoj · CS 2026 · Mangalagiri</div>
          <div class="mem-row" onclick="sendQuick('what is Ghost')"><div class="mem-key">PROJECT</div>Ghost v9 — active</div>
        </div>
      </div>
    </div>
    <div class="sb-section">
      <div class="sb-header" onclick="toggleSection('history')"><span>○</span> History<span class="sb-chevron open" id="chev-history">›</span></div>
      <div class="sb-items open" id="sec-history"><div style="font-family:var(--mono);font-size:9px;color:var(--dim);padding:4px 8px;letter-spacing:1px;">NO HISTORY YET</div></div>
    </div>
    <div class="sb-section">
      <div class="sb-header" onclick="toggleSection('workers')"><span>◎</span> Workers<span class="sb-chevron" id="chev-workers">›</span></div>
      <div class="sb-items" id="sec-workers">
        <div class="sona-row">heartbeat <span class="sona-val">5m</span></div>
        <div class="sona-row">session_cleanup <span class="sona-val">30m</span></div>
        <div class="sona-row">log_rotate <span class="sona-val">6h</span></div>
        <div class="sona-row">memory_backup <span class="sona-val">12h</span></div>
        <div class="sona-row">skill_reload <span class="sona-val">1h</span></div>
        <div class="sona-row">sona_stats <span class="sona-val">2h</span></div>
        <div class="sona-row">vec_optimize <span class="sona-val">4h</span></div>
        <div class="sona-row">sona_dedup <span class="sona-val">3h</span></div>
        <div class="sona-row">memory_sync <span class="sona-val">1h</span></div>
        <div class="sona-row">uptime <span class="sona-val">10m</span></div>
        <div class="sona-row">daily_digest <span class="sona-val">24h</span></div>
        <div class="sona-row">skill_health <span class="sona-val">15m</span></div>
      </div>
    </div>
  </div>
  <div class="main">
    <div class="activity-bar">
      <span class="activity-tag">v9.0.0</span>
      <span class="activity-tag" id="routerTag">router: auto</span>
      <span class="activity-tag" id="memTag">vectors: 0</span>
      <div class="activity-spacer"></div>
      <span class="activity-clear" onclick="clearChat()">clear</span>
    </div>
    <div class="chat-area" id="chatArea">
      <div class="chat-inner" id="chatInner">
        <div class="welcome" id="welcomeScreen">
          <div class="welcome-ghost">GHOST</div>
          <div class="welcome-sub">v9 · autonomous · self-learning · SONA</div>
          <div class="welcome-hints">
            <div class="hint-card" onclick="sendQuick('help me build a remote job strategy')"><div class="hint-card-label">JOBS</div><div class="hint-card-text">Build a remote job strategy</div></div>
            <div class="hint-card" onclick="sendQuick('help me write code')"><div class="hint-card-label">CODE</div><div class="hint-card-text">Write or debug code</div></div>
            <div class="hint-card" onclick="sendQuick('what should I work on today')"><div class="hint-card-label">PLAN</div><div class="hint-card-text">What should I work on today</div></div>
            <div class="hint-card" onclick="sendQuick('show my SONA memory stats')"><div class="hint-card-label">MEMORY</div><div class="hint-card-text">Show SONA learning stats</div></div>
          </div>
        </div>
      </div>
    </div>
    <div class="input-area">
      <div class="input-inner">
        <div class="input-box">
          <textarea id="msgInput" placeholder="Tell Ghost what to do..." rows="1" onkeydown="handleKey(event)" oninput="autoResize(this)"></textarea>
          <button class="send-btn" id="sendBtn" onclick="sendMessage()" disabled>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </div>
        <div class="input-footer">
          <span class="input-hint">ENTER · SHIFT+ENTER for newline</span>
          <div class="input-actions">
            <button class="input-action-btn" onclick="sendQuick('show system status')">status</button>
            <button class="input-action-btn" onclick="sendQuick('show SONA memory stats')">sona</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
let isThinking=false;
const input=document.getElementById('msgInput');
const sendBtn=document.getElementById('sendBtn');
const historyItems=[];
input.addEventListener('input',()=>{sendBtn.disabled=input.value.trim()==='';});
function autoResize(el){el.style.height='auto';el.style.height=Math.min(el.scrollHeight,160)+'px';}
function handleKey(e){if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();if(!sendBtn.disabled&&!isThinking)sendMessage();}}
function toggleSection(name){const sec=document.getElementById('sec-'+name);const chev=document.getElementById('chev-'+name);const open=sec.classList.toggle('open');chev.classList.toggle('open',open);}
function sendQuick(text){input.value=text;autoResize(input);sendBtn.disabled=false;sendMessage();}
async function sendMessage(){
  const text=input.value.trim();
  if(!text||isThinking)return;

  const welcome=document.getElementById('welcomeScreen');
  if(welcome)welcome.remove();
  input.value='';autoResize(input);sendBtn.disabled=true;isThinking=true;
  addUserMsg(text);addToHistory(text);
  const thinkEl=addThinking();
  document.getElementById('statusText').textContent='THINKING';
  try{
    const res=await fetch('/chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:text})});
    const data=await res.json();
    thinkEl.remove();
    addGhostMsg(data.reply||data.response||data.message||JSON.stringify(data));
    if(data.reason)document.getElementById('routerTag').textContent='router: '+data.reason;
  }catch(err){thinkEl.remove();addGhostMsg('Connection error. Make sure Ghost is running on port 3000.');}
  isThinking=false;sendBtn.disabled=input.value.trim()==='';
  document.getElementById('statusText').textContent='ONLINE';
  loadSonaStats();
}
function addUserMsg(text){const now=new Date().toLocaleTimeString('en-US',{hour12:false,hour:'2-digit',minute:'2-digit'});const div=document.createElement('div');div.className='msg user';div.innerHTML=`<div class="msg-avatar user-av">YOU</div><div class="msg-body"><div class="msg-meta">${now}</div><div class="msg-bubble">${escHtml(text)}</div></div>`;document.getElementById('chatInner').appendChild(div);scrollBottom();}
function addGhostMsg(text){const now=new Date().toLocaleTimeString('en-US',{hour12:false,hour:'2-digit',minute:'2-digit'});const div=document.createElement('div');div.className='msg ghost';div.innerHTML=`<div class="msg-avatar ghost-av">G</div><div class="msg-body"><div class="msg-meta">GHOST · ${now}</div><div class="msg-bubble">${formatMsg(text)}</div></div>`;document.getElementById('chatInner').appendChild(div);scrollBottom();}
function addThinking(){const div=document.createElement('div');div.className='thinking';div.innerHTML=`<div class="msg-avatar ghost-av">G</div><div class="thinking-dots"><span></span><span></span><span></span></div>`;document.getElementById('chatInner').appendChild(div);scrollBottom();return div;}
function formatMsg(text){text=text.replace(/```(\w*)\n?([\s\S]*?)```/g,(_,lang,code)=>`<pre><code>${escHtml(code.trim())}</code></pre>`);text=text.replace(/`([^`]+)`/g,'<code>$1</code>');text=text.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');text=text.replace(/\n/g,'<br>');return text;}
function escHtml(t){return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function addToHistory(text){historyItems.unshift(text);if(historyItems.length>12)historyItems.pop();const list=document.getElementById('sec-history');list.innerHTML=historyItems.map(t=>`<div class="hist-row" onclick="sendQuick(${JSON.stringify(t)})"><span style="color:var(--dim);font-size:10px;">○</span><div class="hist-label">${escHtml(t.substring(0,30))}${t.length>30?'…':''}</div></div>`).join('');}
function scrollBottom(){const area=document.getElementById('chatArea');setTimeout(()=>area.scrollTop=area.scrollHeight,50);}
function clearChat(){document.getElementById('chatInner').innerHTML='';historyItems.length=0;document.getElementById('sec-history').innerHTML='<div style="font-family:var(--mono);font-size:9px;color:var(--dim);padding:4px 8px;letter-spacing:1px;">NO HISTORY YET</div>';}
async function loadSkills(){try{const res=await fetch('/agents');const data=await res.json();const sec=document.getElementById('sec-skills');if(!data.skills||!data.skills.length){sec.innerHTML='<div style="font-family:var(--mono);font-size:9px;color:var(--dim);padding:4px 8px;letter-spacing:1px;">NO SKILLS LOADED</div>';return;}sec.innerHTML=data.skills.map(s=>`<div class="skill-row" onclick="sendQuick('use ${s.name}')"><div class="skill-dot"></div><div class="skill-name">${s.name}</div></div>`).join('');if(data.models)document.getElementById('modelPill').textContent='multi-llm';}catch{}}
async function loadSonaStats(){try{const res=await fetch('/sona/stats');const d=await res.json();document.getElementById('sonaVectors').textContent=d.vectorCount||0;document.getElementById('sonaFacts').textContent=d.facts||0;document.getElementById('sonaLearns').textContent=d.learnCount||0;document.getElementById('memTag').textContent='vectors: '+(d.vectorCount||0);}catch{}}
input.focus();loadSkills();loadSonaStats();setInterval(loadSonaStats,30000);



</script>
</body>
</html>