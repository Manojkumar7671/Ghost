        "language": "ts",
        "code": "// __tests__/security/secure-random.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  generateSecureId, generateUUID, generateSecureToken,\n  generateShortId, generateSessionId, secureRandomInt, secureRandomChoice, secureShuffleArray,\n} from '../../src/security/secure-random.js';\n\ndescribe('generateSecureId', () => {\n  it('generates unique IDs', () => {\n    const ids = new Set(Array.from({ length: 100 }, () => generateSecureId()));\n    expect(ids.size).toBe(100);\n  });\n\n  it('applies prefix', () => {\n    expect(generateSecureId('agent')).toMatch(/^agent_/);\n  });\n});\n\ndescribe('generateUUID', () => {\n  it('generates valid UUID v4 format', () => {\n    const uuid = generateUUID();\n    expect(uuid).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);\n  });\n});\n\ndescribe('secureRandomInt', () => {\n  it('returns value within [min, max]', () => {\n    for (let i = 0; i < 100; i++) {\n      const v = secureRandomInt(5, 10);\n      expect(v).toBeGreaterThanOrEqual(5);\n      expect(v).toBeLessThanOrEqual(10);\n    }\n  });\n\n  it('handles single-value range', () => {\n    expect(secureRandomInt(7, 7)).toBe(7);\n  });\n});\n\ndescribe('secureRandomChoice', () => {\n  it('selects element from array', () => {\n    const arr = ['a', 'b', 'c'];\n    const result = secureRandomChoice(arr);\n    expect(arr).toContain(result);\n  });\n\n  it('throws on empty array', () => {\n    expect(() => secureRandomChoice([])).toThrow();\n  });\n});\n\ndescribe('secureShuffleArray', () => {\n  it('returns array with same elements', () => {\n    const arr = [1, 2, 3, 4, 5];\n    const shuffled = secureShuffleArray(arr);\n    expect(shuffled).toHaveLength(arr.length);\n    expect(shuffled.sort()).toEqual([...arr].sort());\n  });\n\n  it('does not mutate original array', () => {\n    const arr = [1, 2, 3];\n    const orig = [...arr];\n    secureShuffleArray(arr);\n    expect(arr).toEqual(orig);\n  });\n});"
