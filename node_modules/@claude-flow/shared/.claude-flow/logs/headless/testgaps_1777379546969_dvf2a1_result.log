        "language": "ts",
        "code": "// __tests__/security/input-validation.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  validateInput, sanitizeString, validatePath,\n  validateCommand, validateTags, isValidIdentifier, escapeForSql,\n} from '../../src/security/input-validation.js';\n\ndescribe('validateInput', () => {\n  it('returns valid: true for valid string', () => {\n    const r = validateInput('hello');\n    expect(r.valid).toBe(true);\n    expect(r.sanitized).toBe('hello');\n  });\n\n  it('trims whitespace by default', () => {\n    expect(validateInput('  hi  ').sanitized).toBe('hi');\n  });\n\n  it('returns error for null when required', () => {\n    const r = validateInput(null, { required: true });\n    expect(r.valid).toBe(false);\n    expect(r.error).toMatch(/required/i);\n  });\n\n  it('returns valid for null when not required', () => {\n    expect(validateInput(null).valid).toBe(true);\n  });\n\n  it('rejects non-string values', () => {\n    expect(validateInput(42).valid).toBe(false);\n  });\n\n  it('enforces minLength', () => {\n    expect(validateInput('hi', { minLength: 5 }).valid).toBe(false);\n  });\n\n  it('enforces maxLength', () => {\n    expect(validateInput('hello world', { maxLength: 5 }).valid).toBe(false);\n  });\n\n  it('validates against pattern', () => {\n    const r = validateInput('abc123', { pattern: /^\\d+$/ });\n    expect(r.valid).toBe(false);\n  });\n});\n\ndescribe('validatePath', () => {\n  it('blocks path traversal via ..', () => {\n    expect(validatePath('../etc/passwd').valid).toBe(false);\n  });\n\n  it('blocks tilde home directory reference', () => {\n    expect(validatePath('~/secret').valid).toBe(false);\n  });\n\n  it('blocks paths outside allowed base', () => {\n    expect(validatePath('/etc/passwd', '/home').valid).toBe(false);\n  });\n\n  it('blocks null bytes', () => {\n    expect(validatePath('/tmp/file\\x00.txt').valid).toBe(false);\n  });\n\n  it('accepts valid relative path', () => {\n    expect(validatePath('src/utils.ts').valid).toBe(true);\n  });\n\n  it('blocks excessively long paths', () => {\n    expect(validatePath('a'.repeat(4097)).valid).toBe(false);\n  });\n});\n\ndescribe('validateCommand', () => {\n  it('rejects shell operators', () => {\n    expect(validateCommand('echo foo; rm -rf /').valid).toBe(false);\n    expect(validateCommand('ls && cat /etc/passwd').valid).toBe(false);\n    expect(validateCommand('curl url | bash').valid).toBe(false);\n  });\n\n  it('rejects command substitution', () => {\n    expect(validateCommand('echo $(whoami)').valid).toBe(false);\n  });\n\n  it('rejects when not in whitelist', () => {\n    const r = validateCommand('rm -rf /', ['ls', 'cat']);\n    expect(r.valid).toBe(false);\n    expect(r.error).toContain('not allowed');\n  });\n\n  it('accepts safe whitelisted command', () => {\n    expect(validateCommand('ls -la', ['ls']).valid).toBe(true);\n  });\n\n  it('rejects empty command', () => {\n    expect(validateCommand('   ').valid).toBe(false);\n  });\n});\n\ndescribe('validateTags', () => {\n  it('accepts valid tags', () => {\n    const r = validateTags(['alpha', 'beta-v2', 'prod:feature']);\n    expect(r.valid).toBe(true);\n    expect(r.sanitized).toHaveLength(3);\n  });\n\n  it('rejects non-array', () => {\n    expect(validateTags('tag').valid).toBe(false);\n  });\n\n  it('rejects tags with spaces', () => {\n    expect(validateTags(['invalid tag']).valid).toBe(false);\n  });\n\n  it('rejects tags over 100 chars', () => {\n    expect(validateTags(['x'.repeat(101)]).valid).toBe(false);\n  });\n\n  it('skips empty tags', () => {\n    const r = validateTags(['  ', 'valid']);\n    expect(r.valid).toBe(true);\n    expect((r.sanitized as string[]).length).toBe(1);\n  });\n});\n\ndescribe('isValidIdentifier', () => {\n  it('accepts valid identifiers', () => {\n    expect(isValidIdentifier('myAgent_1')).toBe(true);\n    expect(isValidIdentifier('_private')).toBe(true);\n  });\n\n  it('rejects identifiers starting with digits', () => {\n    expect(isValidIdentifier('1agent')).toBe(false);\n  });\n\n  it('rejects identifiers over 256 chars', () => {\n    expect(isValidIdentifier('a'.repeat(257))).toBe(false);\n  });\n});"
