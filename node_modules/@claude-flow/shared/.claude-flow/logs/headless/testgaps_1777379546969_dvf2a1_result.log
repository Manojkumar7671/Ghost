=> Promise.resolve('second'));\n\n    resolve1();\n    const [r1, r2] = await Promise.all([result1, result2]);\n    expect(r1).toBe('first');\n    expect(r2).toBe('second');\n  });\n\n  it('rejects when queue is full', async () => {\n    const bh = new Bulkhead({ name: 'full', maxConcurrent: 1, maxQueue: 1, queueTimeout: 5000 });\n    let resolve!: () => void;\n    const blocker = new Promise<void>(r => { resolve = r; });\n\n    bh.execute(() => blocker); // occupies concurrency slot\n    bh.execute(() => Promise.resolve('queued')); // fills queue\n\n    await expect(bh.execute(() => Promise.resolve('overflow')))\n      .rejects.toThrow(\"Bulkhead 'full' is full\");\n    expect(bh.getStats().rejected).toBe(1);\n\n    resolve();\n  });\n\n  it('times out queued items', async () => {\n    const bh = new Bulkhead({ name: 'to', maxConcurrent: 1, maxQueue: 5, queueTimeout: 50 });\n    let resolve!: () => void;\n    const blocker = new Promise<void>(r => { resolve = r; });\n\n    bh.execute(() => blocker);\n    const queued = bh.execute(() => Promise.resolve('ok'));\n\n    await expect(queued).rejects.toThrow('queue timeout');\n    expect(bh.getStats().timedOut).toBe(1);\n\n    resolve();\n  });\n\n  it('calls onRejected callback on full', async () => {\n    const onRejected = vi.fn();\n    const bh = new Bulkhead({ name: 'cb', maxConcurrent: 1, maxQueue: 0, queueTimeout: 1000, onRejected });\n    let resolve!: () => void;\n    const blocker = new Promise<void>(r => { resolve = r; });\n    bh.execute(() => blocker);\n    await bh.execute(() => Promise.resolve()).catch(() => {});\n    expect(onRejected).toHaveBeenCalledWith('full');\n    resolve();\n  });\n});\n\ndescribe('createSemaphore', () => {\n  it('limits concurrent access', async () => {\n    const sem = createSemaphore(2);\n    let active = 0;\n    let maxActive = 0;\n\n    const task = async () => {\n      await sem.acquire();\n      active++;\n      maxActive = Math.max(maxActive, active);\n      await new Promise(r => setTimeout(r, 10));\n      active--;\n      sem.release();\n    };\n\n    await Promise.all([task(), task(), task(), task()]);\n    expect(maxActive).toBeLessThanOrEqual(2);\n  });\n});\n```\n\n---\n\n### 1f. `src/resilience/rate-limiter.ts` — SlidingWindowRateLimiter & TokenBucketRateLimiter\n\n```ts\n// __tests__/resilience/rate-limiter.test.ts\nimport { describe, it, expect } from 'vitest';\nimport { SlidingWindowRateLimiter, TokenBucketRateLimiter } from '../../src/resilience/rate-limiter.js';\n\ndescribe('SlidingWindowRateLimiter', () => {\n  it('allows requests up to limit', () => {\n    const limiter = new SlidingWindowRateLimiter({ maxRequests: 3, windowMs: 10000 });\n    expect(limiter.consume('k').allowed).toBe(true);\n    expect(limiter.consume('k').allowed).toBe(true);\n    expect(limiter.consume('k').allowed).toBe(true);\n    expect(limiter.consume('k').allowed).toBe(false); // 4th blocked\n    limiter.destroy();\n  });\n\n  it('tracks remaining and used counts', () => {\n    const limiter = new SlidingWindowRateLimiter({ maxRequests: 5, windowMs: 10000 });\n    limiter.consume('k');\n    limiter.consume('k');\n    const r = limiter.consume('k');\n    expect(r.used).toBe(3);\n    expect(r.remaining).toBe(2);\n    limiter.destroy();\n  });\n\n  it('check does not consume a token', () => {\n    const limiter = new SlidingWindowRateLimiter({ maxRequests: 1, windowMs: 10000 });\n    limiter.check('k'); // peek only\n    expect(limiter.consume('k').allowed).toBe(true);\n    expect(limiter.consume('k').allowed).toBe(false);\n    limiter.destroy();\n  });\n\n  it('reset clears a key', () => {\n    const limiter = new SlidingWindowRateLimiter({ maxRequests: 1, windowMs: 10000 });\n    limiter.consume('k');\n    limiter.reset('k');\n    expect(limiter.consume('k').allowed).toBe(true);\n    limiter.destroy();\n  });\n\n  it('tracks separately by key', () => {\n    const limiter = new SlidingWindowRateLimiter({ maxRequests: 1, windowMs: 10000 });\n    expect(limiter.consume('user-1').allowed).toBe(true);\n    expect(limiter.consume('user-1').allowed).toBe(false);\n    expect(limiter.consume('user-2').allowed).toBe(true); // separate key\n    limiter.destroy();\n  });\n});\n\ndescribe('TokenBucketRateLimiter', () => {\n  it('starts with full bucket', () => {\n    const limiter = new TokenBucketRateLimiter({ maxRequests: 5, windowMs: 1000 });\n    const r = limiter.check();\n    expect(r.remaining).toBe(5);\n    expect(r.allowed).toBe(true);\n    limiter.destroy();\n  });\n\n  it('consumes tokens on each request', () => {\n    const limiter = new TokenBucketRateLimiter({ maxRequests: 2, windowMs: 10000 });\n    limiter.consume();\n    const r = limiter.consume();\n    expect(r.remaining).toBe(0);\n    expect(limiter.consume().allowed).toBe(false);\n    limiter.destroy();\n  });\n});\n```\n\n---\n\n### 1g. `src/security/input-validation.ts`\n\nZero coverage on all validation functions.\n\n```ts\n// __tests__/security/input-validation.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  validateInput, sanitizeString, validatePath,\n  validateCommand, validateTags, isValidIdentifier, escapeForSql,\n} from '../../src/security/input-validation.js';\n\ndescribe('validateInput', () => {\n  it('returns valid: true for valid string', () => {\n    const r = validateInput('hello');\n    expect(r.valid).toBe(true);\n    expect(r.sanitized).toBe('hello');\n  });\n\n  it('trims whitespace by default', () => {\n    expect(validateInput('  hi  ').sanitized).toBe('hi');\n  });\n\n  it('returns error for null when required', () => {\n    const r = validateInput(null, { required: true });\n    expect(r.valid).toBe(false);\n    expect(r.error).toMatch(/required/i);\n  });\n\n  it('returns valid for null when not required', () => {\n    expect(validateInput(null).valid).toBe(true);\n  });\n\n  it('rejects non-string values', () => {\n    expect(validateInput(42).valid).toBe(false);\n  });\n\n  it('enforces minLength', () => {\n    expect(validateInput('hi', { minLength: 5 }).valid).toBe(false);\n  });\n\n  it('enforces maxLength', () => {\n    expect(validateInput('hello world', { maxLength: 5 }).valid).toBe(false);\n  });\n\n  it('validates against pattern', () => {\n    const r = validateInput('abc123', { pattern: /^\\d+$/ });\n    expect(r.valid).toBe(false);\n  });\n});\n\ndescribe('validatePath', () => {\n  it('blocks path traversal via ..', () => {\n    expect(validatePath('../etc/passwd').valid).toBe(false);\n  });\n\n  it('blocks tilde home directory reference', () => {\n    expect(validatePath('~/secret').valid).toBe(false);\n  });\n\n  it('blocks paths outside allowed base', () => {\n    expect(validatePath('/etc/passwd', '/home').valid).toBe(false);\n  });\n\n  it('blocks null bytes', () => {\n    expect(validatePath('/tmp/file\\x00.txt').valid).toBe(false);\n  });\n\n  it('accepts valid relative path', () => {\n    expect(validatePath('src/utils.ts').valid).toBe(true);\n  });\n\n  it('blocks excessively long paths', () => {\n    expect(validatePath('a'.repeat(4097)).valid).toBe(false);\n  });\n});\n\ndescribe('validateCommand', () => {\n  it('rejects shell operators', () => {\n    expect(validateCommand('echo foo; rm -rf /').valid).toBe(false);\n    expect(validateCommand('ls && cat /etc/passwd').valid).toBe(false);\n    expect(validateCommand('curl url | bash').valid).toBe(false);\n  });\n\n  it('rejects command substitution', () => {\n    expect(validateCommand('echo $(whoami)').valid).toBe(false);\n  });\n\n  it('rejects when not in whitelist', () => {\n    const r = validateCommand('rm -rf /', ['ls', 'cat']);\n    expect(r.valid).toBe(false);\n    expect(r.error).toContain('not allowed');\n  });\n\n  it('accepts safe whitelisted command', () => {\n    expect(validateCommand('ls -la', ['ls']).valid).toBe(true);\n  });\n\n  it('rejects empty command', () => {\n    expect(validateCommand('   ').valid).toBe(false);\n  });\n});\n\ndescribe('validateTags', () => {\n  it('accepts valid tags', () => {\n    const r = validateTags(['alpha', 'beta-v2', 'prod:feature']);\n    expect(r.valid).toBe(true);\n    expect(r.sanitized).toHaveLength(3);\n  });\n\n  it('rejects non-array', () => {\n    expect(validateTags('tag').valid).toBe(false);\n  });\n\n  it('rejects tags with spaces', () => {\n    expect(validateTags(['invalid tag']).valid).toBe(false);\n  });\n\n  it('rejects tags over 100 chars', () => {\n    expect(validateTags(['x'.repeat(101)]).valid).toBe(false);\n  });\n\n  it('skips empty tags', () => {\n    const r = validateTags(['  ', 'valid']);\n    expect(r.valid).toBe(true);\n    expect((r.sanitized as string[]).length).toBe(1);\n  });\n});\n\ndescribe('isValidIdentifier', () => {\n  it('accepts valid identifiers', () => {\n    expect(isValidIdentifier('myAgent_1')).toBe(true);\n    expect(isValidIdentifier('_private')).toBe(true);\n  });\n\n  it('rejects identifiers starting with digits', () => {\n    expect(isValidIdentifier('1agent')).toBe(false);\n  });\n\n  it('rejects identifiers over 256 chars', () => {\n    expect(isValidIdentifier('a'.repeat(257))).toBe(false);\n  });\n});\n```\n\n---\n\n### 1h. `src/security/secure-random.ts`\n\n```ts\n// __tests__/security/secure-random.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  generateSecureId, generateUUID, generateSecureToken,\n  generateShortId, generateSessionId, secureRandomInt, secureRandomChoice, secureShuffleArray,\n} from '../../src/security/secure-random.js';\n\ndescribe('generateSecureId', () => {\n  it('generates unique IDs', () => {\n    const ids = new Set(Array.from({ length: 100 }, () => generateSecureId()));\n    expect(ids.size).toBe(100);\n  });\n\n  it('applies prefix', () => {\n    expect(generateSecureId('agent')).toMatch(/^agent_/);\n  });\n});\n\ndescribe('generateUUID', () => {\n  it('generates valid UUID v4 format', () => {\n    const uuid = generateUUID();\n    expect(uuid).toMatch(/^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);\n  });\n});\n\ndescribe('secureRandomInt', () => {\n  it('returns value within [min, max]', () => {\n    for (let i = 0; i < 100; i++) {\n      const v = secureRandomInt(5, 10);\n      expect(v).toBeGreaterThanOrEqual(5);\n      expect(v).toBeLessThanOrEqual(10);\n    }\n  });\n\n  it('handles single-value range', () => {\n    expect(secureRandomInt(7, 7)).toBe(7);\n  });\n});\n\ndescribe('secureRandomChoice', () => {\n  it('selects element from array', () => {\n    const arr = ['a', 'b', 'c'];\n    const result = secureRandomChoice(arr);\n    expect(arr).toContain(result);\n  });\n\n  it('throws on empty array', () => {\n    expect(() => secureRandomChoice([])).toThrow();\n  });\n});\n\ndescribe('secureShuffleArray', () => {\n  it('returns array with same elements', () => {\n    const arr = [1, 2, 3, 4, 5];\n    const shuffled = secureShuffleArray(arr);\n    expect(shuffled).toHaveLength(arr.length);\n    expect(shuffled.sort()).toEqual([...arr].sort());\n  });\n\n  it('does not mutate original array', () => {\n    const arr = [1, 2, 3];\n    const orig = [...arr];\n    secureShuffleArray(arr);\n    expect(arr).toEqual(orig);\n  });\n});\n```\n\n---\n\n## 2. Gaps in Existing Tests\n\n### 2a. `src/hooks/hooks.test.ts` — HookRegistry & HookExecutor gaps\n\n**Untested in `HookRegistry`:**\n- `unregisterAll(event)` removes only that event's hooks\n- `unregisterAll()` removes all hooks and resets counter\n- `getHook(hookId)` returns definition or `undefined`\n- `count(event)` vs `count()` — scoped vs total\n\n**Untested in `HookExecutor`:**\n- `continueChain === false` stops the chain without setting `aborted = true`\n- `collectResults: false` (default) returns empty `results[]`\n- `executeParallel` throws when `events.length !== contexts.length`\n- `executeParallel` respects `maxParallel` batch size (emits in batches, not all at once)\n- `executeSequential` aborts entire chain when intermediate event fails and `continueOnError` is false\n\n```ts\n// Additional tests to add to src/hooks/hooks.test.ts:\n\ndescribe('HookRegistry — missing coverage', () => {\n  it('unregisterAll(event) removes only that event', () => {\n    registry.register(HookEvent.PreToolUse, vi.fn());\n    registry.register(HookEvent.PreToolUse, vi.fn());\n    registry.register(HookEvent.PostToolUse, vi.fn());\n\n    const removed = registry.unregisterAll(HookEvent.PreToolUse);\n    expect(removed).toBe(2);\n    expect(registry.count(HookEvent.PreToolUse)).toBe(0);\n    expect(registry.count(HookEvent.PostToolUse)).toBe(1);\n  });\n\n  it('unregisterAll() removes everything', () => {\n    registry.register(HookEvent.PreToolUse, vi.fn());\n    registry.register(HookEvent.PostToolUse, vi.fn());\n    const removed = registry.unregisterAll();\n    expect(removed).toBe(2);\n    expect(registry.count()).toBe(0);\n  });\n\n  it('getHook returns definition for valid id', () => {\n    const handler = vi.fn();\n    const id = registry.register(HookEvent.PreEdit, handler);\n    const def = registry.getHook(id);\n    expect(def).toBeDefined();\n    expect(def?.handler).toBe(handler);\n  });\n\n  it('getHook returns undefined for unknown id', () => {\n    expect(registry.getHook('no-such-id')).toBeUndefined();\n  });\n\n  it('count(event) counts only that event', () => {\n    registry.register(HookEvent.PreToolUse, vi.fn());\n    registry.register(HookEvent.PreToolUse, vi.fn());\n    registry.register(HookEvent.PostToolUse, vi.fn());\n    expect(registry.count(HookEvent.PreToolUse)).toBe(2);\n    expect(registry.count()).toBe(3);\n  });\n});\n\ndescribe('HookExecutor — missing coverage', () => {\n  it('continueChain=false stops chain but aborted remains false', async () => {\n    const h1 = vi.fn(async () => ({ success: true }));\n    const h2 = vi.fn(async () => ({ success: true, continueChain: false }));\n    const h3 = vi.fn(async () => ({ success: true }));\n    registry.register(HookEvent.PreEdit, h1, HookPriority.High);\n    registry.register(HookEvent.PreEdit, h2, HookPriority.Normal);\n    registry.register(HookEvent.PreEdit, h3, HookPriority.Low);\n\n    const result = await executor.execute(HookEvent.PreEdit, { event: HookEvent.PreEdit, timestamp: new Date() });\n    expect(result.hooksExecuted).toBe(2);\n    expect(h3).not.toHaveBeenCalled();\n    expect(result.aborted).toBe(false); // chain stopped but not aborted\n  });\n\n  it('collectResults=false returns empty results array', async () => {\n    registry.register(HookEvent.PreEdit, async () => ({ success: true }));\n    const result = await executor.execute(\n      HookEvent.PreEdit,\n      { event: HookEvent.PreEdit, timestamp: new Date() },\n      { collectResults: false }\n    );\n    expect(result.results).toHaveLength(0);\n  });\n\n  it('executeParallel throws when arrays have different lengths', async () => {\n    await expect(\n      executor.executeParallel(\n        [HookEvent.PreEdit],\n        [{ event: HookEvent.PreEdit, timestamp: new Date() }, { event: HookEvent.PostEdit, timestamp: new Date() }]\n      )\n    ).rejects.toThrow('same length');\n  });\n\n  it('executeSequential aborts after failing event when continueOnError is false', async () => {\n    const h1 = vi.fn(async () => { throw new Error('fail'); });\n    const h2 = vi.fn(async () => ({ success: true }));\n    registry.register(HookEvent.PreEdit, h1);\n    registry.register(HookEvent.PostEdit, h2);\n\n    const result = await executor.executeSequential(\n      [HookEvent.PreEdit, HookEvent.PostEdit],\n      { event: HookEvent.PreEdit, timestamp: new Date() }\n    );\n    expect(result.aborted).toBe(true);\n    expect(h2).not.toHaveBeenCalled();\n  });\n});\n```\n\n---\n\n### 2b. `src/events/event-store.test.ts` — EventStore gaps\n\n**Missing:**\n- `ensureInitialized` throws when called before `initialize()`\n- `afterTimestamp` / `beforeTimestamp` filters in `query()`\n- `fromVersion` filter in `query()`\n- `snapshot:recommended` event emitted when version hits `snapshotThreshold`\n- `event:appended` event fired per append\n- `getSnapshot` returns `null` for unknown aggregate\n- Stats `oldestEvent` / `newestEvent` set after appending\n- Stats `snapshotCount` increments after `saveSnapshot`\n\n```ts\n// Additional tests to add to src/events/event-store.test.ts:\n\ndescribe('EventStore — missing coverage', () => {\n  it('throws when methods called before initialize()', async () => {\n    const uninit = new EventStore({ databasePath: ':memory:' });\n    await expect(uninit.append(createAgentSpawnedEvent('a', 'coder', 'core', [])))\n      .rejects.toThrow('not initialized');\n  });\n\n  it('emits event:appended for each append', async () => {\n    const handler = vi.fn();\n    eventStore.on('event:appended', handler);\n    await eventStore.append(createAgentSpawnedEvent('a1', 'coder', 'core', []));\n    expect(handler).toHaveBeenCalledOnce();\n  });\n\n  it('emits snapshot:recommended when version hits threshold', async () => {\n    const store = new EventStore({ databasePath: ':memory:', snapshotThreshold: 2 });\n    await store.initialize();\n    const handler = vi.fn();\n    store.on('snapshot:recommended', handler);\n\n    await store.append(createAgentSpawnedEvent('agg', 'coder', 'core', []));\n    await store.append(createAgentStartedEvent('agg'));\n    expect(handler).toHaveBeenCalledOnce();\n    await store.shutdown();\n  });\n\n  it('query filters by afterTimestamp', async () => {\n    const before = Date.now();\n    await new Promise(r => setTimeout(r, 5));\n    await eventStore.append(createAgentSpawnedEvent('x', 'coder', 'core', []));\n    const events = await eventStore.query({ afterTimestamp: before });\n    expect(events).toHaveLength(1);\n  });\n\n  it('query filters by beforeTimestamp', async () => {\n    await eventStore.append(createAgentSpawnedEvent('x', 'coder', 'core', []));\n    const after = Date.now() + 1000;\n    const events = await eventStore.query({ beforeTimestamp: after });\n    expect(events.length).toBeGreaterThan(0);\n    const noEvents = await eventStore.query({ beforeTimestamp: 0 });\n    expect(noEvents).toHaveLength(0);\n  });\n\n  it('query filters by fromVersion', async () => {\n    await eventStore.append(createAgentSpawnedEvent('v', 'coder', 'core', []));\n    await eventStore.append(createAgentStartedEvent('v'));\n    const events = await eventStore.query({ aggregateIds: ['v'], fromVersion: 2 });\n    expect(events).toHaveLength(1);\n    expect(events[0].version).toBe(2);\n  });\n\n  it('getSnapshot returns null for unknown aggregate', async () => {\n    const snap = await eventStore.getSnapshot('no-such-aggregate');\n    expect(snap).toBeNull();\n  });\n\n  it('stats show oldest/newest timestamps after appending', async () => {\n    await eventStore.append(createAgentSpawnedEvent('a', 'coder', 'core', []));\n    const stats = await eventStore.getStats();\n    expect(stats.oldestEvent).not.toBeNull();\n    expect(stats.newestEvent).not.toBeNull();\n    expect(stats.newestEvent!).toBeGreaterThanOrEqual(stats.oldestEvent!);\n  });\n\n  it('stats count snapshots', async () => {\n    await eventStore.saveSnapshot({\n      aggregateId: 'a1', aggregateType: 'agent',\n      version: 1, state: {}, timestamp: Date.now(),\n    });\n    const stats = await eventStore.getStats();\n    expect(stats.snapshotCount).toBe(1);\n  });\n});\n```\n\n---\n\n### 2c. `src/core/orchestrator/event-coordinator.ts` gaps\n\nThe `EventCoordinator` class has no test file at all.\n\n```ts\n// __tests__/core/orchestrator/event-coordinator.test.ts\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { EventCoordinator } from '../../../src/core/orchestrator/event-coordinator.js';\nimport { createEventBus } from '../../../src/core/event-bus.js';\nimport { SystemEventTypes } from '../../../src/core/interfaces/event.interface.js';\n\ndescribe('EventCoordinator', () => {\n  let coordinator: EventCoordinator;\n  let bus: ReturnType<typeof createEventBus>;\n\n  beforeEach(async () => {\n    bus = createEventBus();\n    coordinator = new EventCoordinator(bus);\n    await coordinator.initialize();\n  });\n\n  afterEach(async () => { await coordinator.shutdown(); });\n\n  it('registers handlers and routes events', async () => {\n    const handler = vi.fn();\n    coordinator.registerHandler('test:event', handler);\n    await bus.emitAsync('test:event', { data: 1 });\n    expect(handler).toHaveBeenCalled();\n  });\n\n  it('unregisters handlers', async () => {\n    const handler = vi.fn();\n    coordinator.registerHandler('ev', handler);\n    coordinator.unregisterHandler('ev', handler);\n    await bus.emitAsync('ev', {});\n    expect(handler).not.toHaveBeenCalled();\n  });\n\n  it('initialize is idempotent', async () => {\n    await coordinator.initialize(); // second call — should not throw or double-register\n    expect(coordinator.isInitialized()).toBe(true);\n  });\n\n  it('shutdown clears handlers', async () => {\n    coordinator.registerHandler('ev', vi.fn());\n    await coordinator.shutdown();\n    expect(coordinator.getRegisteredTypes()).toHaveLength(0);\n    expect(coordinator.isInitialized()).toBe(false);\n  });\n\n  it('getHandlerCount returns correct count', () => {\n    coordinator.registerHandler('ev', vi.fn());\n    coordinator.registerHandler('ev', vi.fn());\n    expect(coordinator.getHandlerCount('ev')).toBe(2);\n    expect(coordinator.getHandlerCount('other')).toBe(0);\n  });\n\n  it('handler errors do not throw from route()', async () => {\n    coordinator.registerHandler('ev', async () => { throw new Error('boom'); });\n    await expect(coordinator.route({ id: '1', type: 'ev', timestamp: new Date(), source: 'test', payload: {} }))\n      .resolves.toBeUndefined();\n  });\n});\n```\n\n---\n\n## 3. Integration Test Gaps\n\nThese cross-cutting scenarios are not covered anywhere:\n\n| Scenario | Missing Test |\n|---|---|\n| Config load → validate → use in TaskManager | No integration test |\n| EventBus ↔ EventCoordinator: coordinator routes events dispatched on bus | No integration test |\n| HookExecutor with real EventBus: `hooks:error` event emitted on handler exception | Partially in hooks.test.ts but only verifies execution, not bus event shape |\n| TaskManager.cleanup() removes tasks older than threshold | TaskManager has no tests at all |\n| TaskQueue priority ordering with `updatePriority()` reordering | No test |\n| SessionHooksManager + InMemorySessionStorage: full round-trip store and list | Partially tested but `list()` not verified independently |\n\n```ts\n// __tests__/core/orchestrator/task-manager.test.ts (skeleton)\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { TaskQueue, TaskManager } from '../../../src/core/orchestrator/task-manager.js';\nimport { createEventBus } from '../../../src/core/event-bus.js';\n\ndescribe('TaskQueue', () => {\n  let queue: TaskQueue;\n  beforeEach(() => { queue = new TaskQueue(); });\n\n  it('dequeues in priority order', async () => {\n    const make = (id: string, priority: number) =>\n      ({ id, type: 'test', description: '', priority, createdAt: new Date(), status: 'pending' as const });\n    await queue.enqueue(make('low', 10));\n    await queue.enqueue(make('high', 90));\n    await queue.enqueue(make('mid', 50));\n    expect((await queue.dequeue())!.id).toBe('high');\n    expect((await queue.dequeue())!.id).toBe('mid');\n    expect((await queue.dequeue())!.id).toBe('low');\n  });\n\n  it('updatePriority re-sorts queue', async () => {\n    const make = (id: string, p: number) =>\n      ({ id, type: 't', description: '', priority: p, createdAt: new Date(), status: 'pending' as const });\n    await queue.enqueue(make('a', 10));\n    await queue.enqueue(make('b', 20));\n    await queue.updatePriority('a', 100);\n    expect((await queue.dequeue())!.id).toBe('a');\n  });\n\n  it('remove returns false for missing task', async () => {\n    expect(await queue.remove('ghost')).toBe(false);\n  });\n});\n\ndescribe('TaskManager', () => {\n  let manager: TaskManager;\n  let bus: ReturnType<typeof createEventBus>;\n\n  beforeEach(() => {\n    bus = createEventBus();\n    manager = new TaskManager(bus);\n  });\n\n  it('createTask emits TASK_CREATED event', async () => {\n    const handler = vi.fn();\n    bus.on('task:created', handler);\n    await manager.createTask({ type: 'work', description: 'Do stuff' });\n    expect(handler).toHaveBeenCalled();\n  });\n\n  it('assignTask throws for unknown task', async () => {\n    await expect(manager.assignTask('ghost', 'agent-1')).rejects.toThrow('Task not found');\n  });\n\n  it('getTasks filters by status', async () => {\n    const t1 = await manager.createTask({ type: 'a', description: 'd' });\n    await manager.createTask({ type: 'b', description: 'd' });\n    await manager.assignTask(t1.id, 'agent-1');\n    const assigned = manager.getTasks({ status: 'assigned' });\n    expect(assigned).toHaveLength(1);\n    expect(assigned[0].id).toBe(t1.id);\n  });\n\n  it('getMetrics tracks completed and failed counts', async () => {\n    const t = await manager.createTask({ type: 'x', description: 'd' });\n    await manager.completeTask(t.id, { taskId: t.id, success: true, duration: 100 });\n    const m = manager.getMetrics();\n    expect(m.completedTasks).toBe(1);\n    expect(m.totalTasks).toBe(1);\n  });\n});\n```\n\n---\n\n## Priority Order for Implementation\n\n| Priority | Module | Risk if untested |\n|---|---|---|\n| **Critical** | `src/security/input-validation.ts` | Security bugs go undetected (path traversal, injection) |\n| **Critical** | `src/resilience/circuit-breaker.ts` | State machine bugs cause cascading failures in prod |\n| **High** | `src/core/event-bus.ts` | Core pub/sub is foundational — silent dispatch bugs |\n| **High** | `src/core/config/validator.ts` | Invalid configs silently accepted or cryptically rejected |\n| **High** | `src/resilience/retry.ts` | Retry exhaustion / non-retryable filtering bugs |\n| **Medium** | `src/core/orchestrator/event-coordinator.ts` | Event routing gaps not caught |\n| **Medium** | `src/core/orchestrator/task-manager.ts` | TaskQueue priority ordering bugs |\n| **Medium** | `src/resilience/bulkhead.ts` + `rate-limiter.ts` | Resource protection failures |\n| **Lower** | `src/security/secure-random.ts` | Wraps well-tested Node crypto — lower risk |\n| **Lower** | Event-store edge cases | Functional core is tested; edge cases are non-critical |\n",
