        "language": "ts",
        "code": "// __tests__/resilience/retry.test.ts\nimport { describe, it, expect, vi } from 'vitest';\nimport { retry, withRetry, RetryableErrors } from '../../src/resilience/retry.js';\n\ndescribe('retry', () => {\n  it('returns result on first success', async () => {\n    const fn = vi.fn(() => Promise.resolve('value'));\n    const result = await retry(fn, { maxAttempts: 3 });\n    expect(result.success).toBe(true);\n    expect(result.result).toBe('value');\n    expect(result.attempts).toBe(1);\n    expect(fn).toHaveBeenCalledOnce();\n  });\n\n  it('retries on failure and eventually succeeds', async () => {\n    let calls = 0;\n    const fn = vi.fn(() => {\n      calls++;\n      if (calls < 3) return Promise.reject(new Error('fail'));\n      return Promise.resolve('ok');\n    });\n    const result = await retry(fn, { maxAttempts: 5, initialDelay: 1 });\n    expect(result.success).toBe(true);\n    expect(result.attempts).toBe(3);\n  });\n\n  it('returns failure after exhausting all attempts', async () => {\n    const fn = vi.fn(() => Promise.reject(new Error('always fails')));\n    const result = await retry(fn, { maxAttempts: 3, initialDelay: 1 });\n    expect(result.success).toBe(false);\n    expect(result.attempts).toBe(3);\n    expect(result.errors).toHaveLength(3);\n  });\n\n  it('stops immediately for non-retryable errors', async () => {\n    const fn = vi.fn(() => Promise.reject(new Error('permanent')));\n    const result = await retry(fn, {\n      maxAttempts: 5,\n      initialDelay: 1,\n      retryableErrors: (e) => e.message !== 'permanent',\n    });\n    expect(result.success).toBe(false);\n    expect(result.attempts).toBe(1);\n    expect(fn).toHaveBeenCalledOnce();\n  });\n\n  it('calls onRetry callback with attempt info', async () => {\n    const onRetry = vi.fn();\n    const fn = vi.fn()\n      .mockRejectedValueOnce(new Error('fail'))\n      .mockResolvedValueOnce('ok');\n    await retry(fn, { maxAttempts: 3, initialDelay: 1, onRetry });\n    expect(onRetry).toHaveBeenCalledOnce();\n    expect(onRetry.mock.calls[0][1]).toBe(1); // attempt number\n  });\n\n  it('respects maxDelay cap', async () => {\n    const delays: number[] = [];\n    const fn = vi.fn(() => Promise.reject(new Error('fail')));\n    const onRetry = (_: Error, __: number, delay: number) => delays.push(delay);\n    await retry(fn, {\n      maxAttempts: 5, initialDelay: 1000, backoffMultiplier: 10,\n      maxDelay: 500, jitter: 0, onRetry,\n    });\n    expect(delays.every(d => d <= 500)).toBe(true);\n  });\n});\n\ndescribe('RetryableErrors', () => {\n  it('network detects ECONNRESET', () => {\n    expect(RetryableErrors.network(new Error('ECONNRESET'))).toBe(true);\n    expect(RetryableErrors.network(new Error('syntax error'))).toBe(false);\n  });\n\n  it('rateLimit detects 429', () => {\n    expect(RetryableErrors.rateLimit(new Error('429 Too Many'))).toBe(true);\n  });\n\n  it('transient combines network + rateLimit + 5xx', () => {\n    expect(RetryableErrors.transient(new Error('ETIMEDOUT'))).toBe(true);\n    expect(RetryableErrors.transient(new Error('500 Internal Server Error'))).toBe(true);\n    expect(RetryableErrors.transient(new Error('validation error'))).toBe(false);\n  });\n});"
      },
