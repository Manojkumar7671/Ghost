        "code": "// __tests__/core/orchestrator/task-manager.test.ts (skeleton)\nimport { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { TaskQueue, TaskManager } from '../../../src/core/orchestrator/task-manager.js';\nimport { createEventBus } from '../../../src/core/event-bus.js';\n\ndescribe('TaskQueue', () => {\n  let queue: TaskQueue;\n  beforeEach(() => { queue = new TaskQueue(); });\n\n  it('dequeues in priority order', async () => {\n    const make = (id: string, priority: number) =>\n      ({ id, type: 'test', description: '', priority, createdAt: new Date(), status: 'pending' as const });\n    await queue.enqueue(make('low', 10));\n    await queue.enqueue(make('high', 90));\n    await queue.enqueue(make('mid', 50));\n    expect((await queue.dequeue())!.id).toBe('high');\n    expect((await queue.dequeue())!.id).toBe('mid');\n    expect((await queue.dequeue())!.id).toBe('low');\n  });\n\n  it('updatePriority re-sorts queue', async () => {\n    const make = (id: string, p: number) =>\n      ({ id, type: 't', description: '', priority: p, createdAt: new Date(), status: 'pending' as const });\n    await queue.enqueue(make('a', 10));\n    await queue.enqueue(make('b', 20));\n    await queue.updatePriority('a', 100);\n    expect((await queue.dequeue())!.id).toBe('a');\n  });\n\n  it('remove returns false for missing task', async () => {\n    expect(await queue.remove('ghost')).toBe(false);\n  });\n});\n\ndescribe('TaskManager', () => {\n  let manager: TaskManager;\n  let bus: ReturnType<typeof createEventBus>;\n\n  beforeEach(() => {\n    bus = createEventBus();\n    manager = new TaskManager(bus);\n  });\n\n  it('createTask emits TASK_CREATED event', async () => {\n    const handler = vi.fn();\n    bus.on('task:created', handler);\n    await manager.createTask({ type: 'work', description: 'Do stuff' });\n    expect(handler).toHaveBeenCalled();\n  });\n\n  it('assignTask throws for unknown task', async () => {\n    await expect(manager.assignTask('ghost', 'agent-1')).rejects.toThrow('Task not found');\n  });\n\n  it('getTasks filters by status', async () => {\n    const t1 = await manager.createTask({ type: 'a', description: 'd' });\n    await manager.createTask({ type: 'b', description: 'd' });\n    await manager.assignTask(t1.id, 'agent-1');\n    const assigned = manager.getTasks({ status: 'assigned' });\n    expect(assigned).toHaveLength(1);\n    expect(assigned[0].id).toBe(t1.id);\n  });\n\n  it('getMetrics tracks completed and failed counts', async () => {\n    const t = await manager.createTask({ type: 'x', description: 'd' });\n    await manager.completeTask(t.id, { taskId: t.id, success: true, duration: 100 });\n    const m = manager.getMetrics();\n    expect(m.completedTasks).toBe(1);\n    expect(m.totalTasks).toBe(1);\n  });\n});"
