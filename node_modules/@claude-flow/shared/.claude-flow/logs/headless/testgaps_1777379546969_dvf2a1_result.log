eateAgentSpawnedEvent('v', 'coder', 'core', []));\n    await eventStore.append(createAgentStartedEvent('v'));\n    const events = await eventStore.query({ aggregateIds: ['v'], fromVersion: 2 });\n    expect(events).toHaveLength(1);\n    expect(events[0].version).toBe(2);\n  });\n\n  it('getSnapshot returns null for unknown aggregate', async () => {\n    const snap = await eventStore.getSnapshot('no-such-aggregate');\n    expect(snap).toBeNull();\n  });\n\n  it('stats show oldest/newest timestamps after appending', async () => {\n    await eventStore.append(createAgentSpawnedEvent('a', 'coder', 'core', []));\n    const stats = await eventStore.getStats();\n    expect(stats.oldestEvent).not.toBeNull();\n    expect(stats.newestEvent).not.toBeNull();\n    expect(stats.newestEvent!).toBeGreaterThanOrEqual(stats.oldestEvent!);\n  });\n\n  it('stats count snapshots', async () => {\n    await eventStore.saveSnapshot({\n      aggregateId: 'a1', aggregateType: 'agent',\n      version: 1, state: {}, timestamp: Date.now(),\n    });\n    const stats = await eventStore.getStats();\n    expect(stats.snapshotCount).toBe(1);\n  });\n});"
