        "code": "// __tests__/core/config/validator.test.ts\nimport { describe, it, expect } from 'vitest';\nimport {\n  validateAgentConfig, validateTaskConfig, validateSwarmConfig,\n  validateMemoryConfig, validateSystemConfig, ConfigValidator,\n} from '../../../src/core/config/index.js';\n\ndescribe('validateAgentConfig', () => {\n  it('accepts valid agent config', () => {\n    const result = validateAgentConfig({ id: 'a1', name: 'Coder', type: 'coder' });\n    expect(result.success).toBe(true);\n    expect(result.data?.capabilities).toEqual([]);   // default applied\n    expect(result.data?.priority).toBe(50);          // default\n  });\n\n  it('rejects missing required fields', () => {\n    const result = validateAgentConfig({ name: 'Coder' });\n    expect(result.success).toBe(false);\n    expect(result.errors?.some(e => e.path === 'id')).toBe(true);\n  });\n\n  it('rejects priority out of range', () => {\n    const result = validateAgentConfig({ id: 'a1', name: 'X', type: 'coder', priority: 101 });\n    expect(result.success).toBe(false);\n  });\n});\n\ndescribe('validateSwarmConfig', () => {\n  it('rejects unknown topology', () => {\n    const result = validateSwarmConfig({ topology: 'unknown' });\n    expect(result.success).toBe(false);\n  });\n\n  it('accepts all valid topologies', () => {\n    const topologies = ['hierarchical', 'mesh', 'ring', 'star', 'adaptive', 'hierarchical-mesh'];\n    for (const topology of topologies) {\n      expect(validateSwarmConfig({ topology }).success).toBe(true);\n    }\n  });\n});\n\ndescribe('ConfigValidator', () => {\n  it('validateOrThrow throws with readable message', () => {\n    expect(() => ConfigValidator.validateAgentOrThrow({ name: 'X' }))\n      .toThrow('Invalid agent configuration');\n  });\n\n  it('isValid returns false for invalid data', () => {\n    const { AgentConfigSchema } = require('../../../src/core/config/schema.js');\n    expect(ConfigValidator.isValid(AgentConfigSchema, {})).toBe(false);\n  });\n});"
