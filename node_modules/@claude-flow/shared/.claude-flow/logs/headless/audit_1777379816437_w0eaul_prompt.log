 * Aligned with ADR-006 (Unified Memory Service) and ADR-009 (Hybrid Memory Backend)
 */

/**
 * Memory entry types
 */
export type MemoryType = 'session' | 'persistent' | 'vector' | 'cache' | 'pattern';

/**
 * Memory entry structure
 */
