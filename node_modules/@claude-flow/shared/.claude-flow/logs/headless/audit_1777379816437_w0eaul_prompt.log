  readonly key: string;
  readonly type: MemoryType;
  readonly createdAt: Date;

  value: unknown;
  updatedAt: Date;
  expiresAt?: Date;

  metadata?: {
    source?: string;
    agentId?: string;
    sessionId?: string;
    version?: number;
    tags?: string[];
    embedding?: number[];
    [key: string]: unknown;
  };
}

/**
 * Memory entry creation parameters
 */
export interface IMemoryEntryCreate {
  key: string;
  value: unknown;
  type?: MemoryType;
  expiresAt?: Date;
  ttlMs?: number;
  metadata?: IMemoryEntry['metadata'];
}

