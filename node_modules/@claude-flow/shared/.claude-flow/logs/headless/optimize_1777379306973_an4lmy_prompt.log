  unregisterCheck(name: string): void;

  /**
   * Get health history
   */
  getHistory(limit?: number): IHealthStatus[];

  /**
   * Subscribe to health changes
   */
  onHealthChange(callback: (status: IHealthStatus) => void): () => void;
}

