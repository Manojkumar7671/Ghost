    backoffMultiplier: z.number().positive().default(2),
  }).optional(),
  resources: z.object({
    maxMemoryMb: z.number().int().positive().optional(),
    maxCpuPercent: z.number().min(0).max(100).optional(),
  }).optional(),
  metadata: z.record(z.unknown()).optional(),
});

